                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "ASR EN VIVO",
                      "fontFamily": "Roboto Mono",
                      "fontSize": 13,
                      "fontWeight": "700",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "BthdV",
                      "name": "b",
                      "fill": "$ui:--border",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Transcripción en streaming: los pasos del guion se marcan solos, el medidor corrige en tiempo real y una frase prohibida puede alertar durante la llamada.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
