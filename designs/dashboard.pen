                      "width": "fill_container",
                      "content": "CALIDAD = VOLUMEN",
                      "fontFamily": "Roboto Mono",
                      "fontSize": 13,
                      "fontWeight": "700",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "Ah1ki",
                      "name": "b",
                      "fill": "$ui:--border",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "El puntaje de profesionalismo no multiplica el pago: decide cuántas llamadas te asigna el enrutador. Por eso la prioridad se ve en Mi día, no escondida en Mi desempeño.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
