                      "name": "t",
                      "fill": "#22D3EE",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "MARCACIÓN PREDICTIVA",
                      "fontFamily": "Roboto Mono",
                      "fontSize": 13,
                      "fontWeight": "700",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "JXIs5",
                      "name": "b",
                      "fill": "$ui:--border",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "El motor marca y entrega la llamada ya conectada. Por eso la pantalla abre en caliente: tipografía grande en la ficha y el guion ya posicionado en el paso de apertura.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "DE8f2",
                  "name": "ASR EN VIVO",
                  "width": "fill_container",
                  "fill": "#22D3EE1F",
