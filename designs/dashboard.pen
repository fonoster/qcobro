                      "name": "t",
                      "fill": "#22D3EE",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "PUNTOS, SIN BASE",
                      "fontFamily": "Roboto Mono",
                      "fontSize": 13,
                      "fontWeight": "700",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "DwU2T",
                      "name": "b",
                      "fill": "$ui:--border",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "No hay pago fijo. Contacto < promesa < monto recuperado. El puntaje se muestra primero y el peso equivalente debajo, porque los puntos se mueven en cada llamada y el dinero se liquida después.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
