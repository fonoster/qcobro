{
  "name": "@qcobro/ctl",
  "version": "1.39.2",
  "description": "Command-line tool for QCobro developers, built on @qcobro/sdk.",
  "type": "module",
  "bin": {
    "qcobro": "./bin/run.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --force",
    "postbuild": "chmod +x ./bin/run.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "generate:readme": "oclif readme"
  },
  "oclif": {
    "bin": "qcobro",
    "dirname": "qcobro",
    "commands": "./dist/commands",
    "topicSeparator": ":",
    "plugins": [
      "@oclif/plugin-warn-if-update-available"
    ],
    "warn-if-update-available": {
      "timeoutInDays": 7,
      "message": "<%= config.name %> update available from <%= chalk.greenBright(config.version) %> to <%= chalk.greenBright(latest) %>.",
      "frequency": 1,
      "frequencyUnit": "days"
    }
  },
  "dependencies": {
    "@inquirer/prompts": "^7.1.0",
    "@oclif/core": "^4.0.34",
    "@oclif/plugin-warn-if-update-available": "^3.1.28",
    "@qcobro/common": "^1.39.2",
    "@qcobro/sdk": "^1.39.2",
    "chalk": "^5.3.0",
    "cliui": "^8.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.3",
    "@qcobro/apiserver": "^1.39.2",
    "@types/node": "22.10.1",
    "oclif": "^4.17.46",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
